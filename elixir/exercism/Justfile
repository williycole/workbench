# NB: exercism.org/api/v2 (the website API) is now Cloudflare bot-walled — curl gets an
# HTML "Just a moment..." challenge, not JSON. The exercise catalog now comes from the
# public track repo (no auth). Per-user unlock/submitted status is no longer scriptable,
# so recipes use "downloaded locally" as the practical proxy. Download/submit still use
# the official `exercism` CLI (different host, api.exercism.io — not walled).
catalog := "https://raw.githubusercontent.com/exercism/elixir/main/config.json"
workspace := `jq -r '.workspace' ~/.config/exercism/user.json`
current_file := `jq -r '.workspace' ~/.config/exercism/user.json` + "/.current"
invocation_dir := invocation_directory()

_current:
    #!/usr/bin/env bash
    shopt -s nocasematch
    if [[ "{{invocation_dir}}" =~ ^"{{workspace}}/elixir/"([^/]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        if [ ! -f "{{current_file}}" ]; then
            echo "No current exercise set. Run 'just next' or 'just get <slug>'." >&2
            exit 1
        fi
        cat "{{current_file}}"
    fi



# list all exercises; ✓ = downloaded locally (unlock status no longer available — see header)
list:
    #!/usr/bin/env bash
    curl -s "{{catalog}}" \
      | jq -r '(.exercises.concept[] | [.slug, "concept"]), (.exercises.practice[] | [.slug, "practice"]) | @tsv' \
      | while IFS=$'\t' read -r slug type; do
          [ -d "{{workspace}}/elixir/$slug" ] && dl="✓" || dl="·"
          printf '%s\t%s\t%s\n' "$dl" "$type" "$slug"
        done \
      | column -t -s $'\t'

# download + open the next unlocked concept exercise you don't have yet (syllabus order).
# The CLI enforces unlock, so we walk the syllabus and skip anything it reports as locked.
next:
    #!/usr/bin/env bash
    concepts=$(curl -s "{{catalog}}" | jq -r '.exercises.concept[].slug' 2>/dev/null)
    [ -z "$concepts" ] && { echo "Could not fetch track catalog (network?)."; exit 1; }
    picked=""
    while IFS= read -r slug; do
        [ -d "{{workspace}}/elixir/$slug" ] && continue          # already downloaded
        echo "→ trying $slug"
        if out=$(exercism download --track=elixir --exercise="$slug" 2>&1); then
            picked="$slug"; break
        elif echo "$out" | grep -qi "not unlocked"; then
            echo "  locked — skipping"; continue
        else
            echo "$out"; exit 1                                  # real error (network/auth)
        fi
    done <<< "$concepts"
    if [ -z "$picked" ]; then
        echo "No unlocked concept exercises left to download. Try a practice one: just get <slug>"
        exit 0
    fi
    echo "$picked" > "{{current_file}}"
    file=$(find "{{workspace}}/elixir/$picked/lib" -name "*.ex" | head -1)
    [ -n "$file" ] && nvim "$file" < /dev/tty

# show the instructions for the current exercise
docs:
    #!/usr/bin/env bash
    shopt -s nocasematch
    if [[ "{{invocation_dir}}" =~ ^"{{workspace}}/elixir/"([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}"
    else
        slug=$(cat "{{current_file}}")
    fi
    glow -p "{{workspace}}/elixir/$slug/README.md"

# show hints for the current exercise
hints:
    #!/usr/bin/env bash
    shopt -s nocasematch
    if [[ "{{invocation_dir}}" =~ ^"{{workspace}}/elixir/"([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}"
    else
        slug=$(cat "{{current_file}}")
    fi
    f="{{workspace}}/elixir/$slug/HINTS.md"
    [ -f "$f" ] && glow -p "$f" || echo "No hints file for this exercise."

# run tests for the current exercise
test:
    #!/usr/bin/env bash
    shopt -s nocasematch
    if [[ "{{invocation_dir}}" =~ ^"{{workspace}}/elixir/"([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}"
    else
        slug=$(cat "{{current_file}}")
    fi
    cd "{{workspace}}/elixir/$slug" && mix test

# submit the current exercise
submit:
    #!/usr/bin/env bash
    shopt -s nocasematch
    if [[ "{{invocation_dir}}" =~ ^"{{workspace}}/elixir/"([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}"
    else
        slug=$(cat "{{current_file}}")
    fi
    file=$(find "{{workspace}}/elixir/$slug/lib" -name "*.ex" | head -1)
    exercism submit "$file"

# open current exercise in nvim
open:
    #!/usr/bin/env bash
    shopt -s nocasematch
    if [[ "{{invocation_dir}}" =~ ^"{{workspace}}/elixir/"([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}"
    else
        slug=$(cat "{{current_file}}")
    fi
    file=$(find "{{workspace}}/elixir/$slug/lib" -name "*.ex" | head -1)
    [ -n "$file" ] && nvim "$file" < /dev/tty || echo "No exercises downloaded yet."

# open current exercise on exercism.org to mark complete
complete:
    #!/usr/bin/env bash
    shopt -s nocasematch
    if [[ "{{invocation_dir}}" =~ ^"{{workspace}}/elixir/"([^/]+) ]]; then
        slug="${BASH_REMATCH[1]}"
    else
        slug=$(cat "{{current_file}}")
    fi
    open "https://exercism.org/tracks/elixir/exercises/$slug"

# download a specific exercise and set it as current: just get <slug>
get slug:
    #!/usr/bin/env bash
    exercism download --track=elixir --exercise={{slug}}
    echo "{{slug}}" > "{{current_file}}"

# download all concept exercises (the elixir syllabus); skips ones already present
get-all:
    #!/usr/bin/env bash
    slugs=$(curl -s "{{catalog}}" | jq -r '.exercises.concept[].slug' 2>/dev/null)
    [ -z "$slugs" ] && { echo "Could not fetch track catalog (network?)."; exit 1; }
    count=0
    for slug in $slugs; do
        [ -d "{{workspace}}/elixir/$slug" ] && continue
        echo "→ $slug"
        if exercism download --track=elixir --exercise="$slug" --force > /dev/null 2>&1; then
            count=$((count+1))
        else
            echo "  (skipped — locked or download failed)"
        fi
    done
    echo "Done. Downloaded $count new exercises."
